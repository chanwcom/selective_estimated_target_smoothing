# Python bytecode
__pycache__/
*.py[cod]

# Raw per-run training / inference logs. ~156M across ~296 files as of this
# commit, and they grow with every sweep. The distilled results are kept:
# each sweep's summary.json (multi-seed mean/std per grid cell) IS tracked,
# which is what any analysis actually reads.
*.log

# Model checkpoints and HuggingFace run outputs.
checkpoint-*/
wandb/

# Per-machine paths (dataset root, CWK checkout, checkpoint dir). Every
# machine keeps its own copy, made from config.local.sh.example -- tracking
# it would put one machine's absolute paths in everyone else's clone.
config.local.sh
